# =============================================================================
# IOTA Gas Station — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Follow the README.md for the step-by-step setup.
# =============================================================================

# --- IOTA Network ---
NODE_URL=https://api.testnet.iota.cafe
EXPLORER_URL=https://explorer.rebased.iota.org

# --- Gas Station ---
GAS_STATION_URL=http://localhost:9527
GAS_STATION_AUTH=your-strong-bearer-token-here

# --- Gas Station Account (owns gas coins, co-signs sponsored txs) ---
GAS_STATION_ADDRESS=
GAS_STATION_PRIVATE_KEY=

# --- Service Account (the account that calls smart contracts) ---
# This account does NOT need IOTA; the Gas Station pays gas.
SERVICE_ACCOUNT_ADDRESS=
SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Contract (from 2-deploy.sh) ---
PACKAGE_ID=

# ---------------------------------------------------------------------------
# AWS KMS (only needed with docker-compose.aws.yaml override)
# ---------------------------------------------------------------------------
# AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/abcd-1234-efgh-5678
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=secret...
