# IOTA Hierarchies Configuration

# Required: Package ID from deploying hierarchies-move
# Get this by running: https://github.com/iotaledger/hierarchies/blob/main/hierarchies-move/scripts/publish_hierarchies.sh
# 
# For pre-deployed networks, use these package IDs:
# Testnet: 0xeac926704d207ec57acae24151c5517db9cead233d785ea3142b559ae065a114
# Mainnet: 0x0f75165f01198edbc758df00d61440a46300efb639f3a5c33a7c797a8a66d371
# Devnet:  0x373c0013c63394509b220a70307a54c323729369a574197c19c9c571c64e68be
IOTA_HIERARCHIES_PKG_ID=

# Network configuration (default: localnet)
NETWORK_URL=http://127.0.0.1:9000
NETWORK_NAME_FAUCET=localnet

# For testnet, use:
# IOTA_HIERARCHIES_PKG_ID=0xeac926704d207ec57acae24151c5517db9cead233d785ea3142b559ae065a114
# NETWORK_URL=https://api.testnet.iota.cafe:443
# NETWORK_NAME_FAUCET=testnet

# For mainnet, use:
# IOTA_HIERARCHIES_PKG_ID=0x0f75165f01198edbc758df00d61440a46300efb639f3a5c33a7c797a8a66d371
# NETWORK_URL=https://api.mainnet.iota.cafe:443
# NETWORK_NAME_FAUCET=mainnet

# For devnet, use:
# IOTA_HIERARCHIES_PKG_ID=0x373c0013c63394509b220a70307a54c323729369a574197c19c9c571c64e68be
# NETWORK_URL=https://api.devnet.iota.cafe:443
# NETWORK_NAME_FAUCET=devnet
